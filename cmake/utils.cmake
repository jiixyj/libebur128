macro(to_yes_no vars)
  foreach(var ${ARGV})
    if(${var})
      set(${var} "yes")
    else()
      set(${var} "no ")
    endif()
  endforeach()
endmacro()

macro(if_empty_print_missing vars)
  foreach(var ${ARGV})
    if(NOT ${var})
      set(${var} "<not set>")
    endif()
  endforeach()
endmacro()
